{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Unknow Web Browser",
  "mainBinaryName": "UnknowWeb",
  "version": "0.1.0",
  "identifier": "app.unknowweb.browser",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Unknow Web Browser",
    "shortDescription": "Unknow Web Browser",
    "longDescription": "A light web browser on the system WebView2.",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
